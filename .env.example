# Kick Account Credentials
KICK_USERNAME=your_username
KICK_PASSWORD=your_password

# Streamers to monitor (comma-separated)
STREAMERS=streamer1,streamer2,streamer3

# Emojis to send (comma-separated)
EMOJIS=❤️,😂,👍,🔥,💯

# Interval settings (in milliseconds)
MIN_INTERVAL=60000
MAX_INTERVAL=300000

# Connection settings
RECONNECT_DELAY=5000
MAX_RETRIES=5
